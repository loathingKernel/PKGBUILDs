# Co-Maintainer: George Rawlinson <george@rawlinson.net.nz>
# Contributor: Mark Wagie <mark dot wagie at proton dot me>
# Contributor: Ranieri Althoff <ranisalt+aur at gmail dot com>
_pkgname=MangoHud
pkgname=lib32-mangohud-git
pkgver=0.8.4.r130.g8bd15ed9
pkgrel=1
pkgdesc="32-bit libraries for MangoHud and MangoApp"
arch=('x86_64')
url="https://github.com/flightlessmango/MangoHud"
license=('MIT')
makedepends=('appstream' 'git' 'glfw-x11' 'glslang' 'lib32-cmocka' 'lib32-libcap' 'lib32-libglvnd' 'lib32-yaml-cpp' 'libxnvctrl' 'lib32-libxrandr' 'meson' 'nlohmann-json' 'python-mako' 'vulkan-headers' 'wayland-protocols' 'yaml-cpp')
depends=('lib32-dbus' 'lib32-gcc-libs' 'lib32-libcap' 'lib32-glew' 'lib32-libx11' 'lib32-libxkbcommon' 'lib32-vulkan-icd-loader' 'lib32-wayland')
provides=("${pkgname//-git}")
conflicts=("${pkgname//-git}" 'lib32-mangoapp')
replaces=('lib32-mangoapp')
source=("git+https://github.com/flightlessmango/MangoHud.git")
b2sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    git describe --long --tags | sed -r 's/^v//;s/([^-]*-g)/r\1/;s/-/./g'
}

prepare() {
    cd "$_pkgname"

    # Use system cmocka instead of subproject
    sed --in-place "s/  cmocka = subproject('cmocka')//g" meson.build
    sed --in-place "s/cmocka_dep = cmocka.get_variable('cmocka_dep')/cmocka_dep = dependency('cmocka')/g" meson.build
}

build() {
    export CC="gcc -m32"
    export CXX="g++ -m32"
    export PKG_CONFIG_PATH="/usr/lib32/pkgconfig"
    export LLVM_CONFIG="/usr/bin/llvm-config32"

    arch-meson "$_pkgname" build \
        --wrap-mode=default \
        --libdir lib32 \
        -Dinclude_doc=false \
        -Dwith_server=false \
        -Dmangoapp=false \
        -Dmangohudctl=false

    meson compile -C build
}

package() {
    meson install -C build --tags runtime,mangoapp --destdir "$pkgdir"

    # mangoplot is provided by mangohud, no option to disable in the build
    rm -rf "$pkgdir/usr/bin"

    install -Dm 0644 "$srcdir/$_pkgname/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
